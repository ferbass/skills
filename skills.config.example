# Personal configuration for the skills in this repo.
#
# Copy this file to `skills.config` (gitignored) and fill in your values:
#
#   cp skills.config.example skills.config
#
# `install.sh` links your `skills.config` to ~/.config/skills/config so the
# skills can find it at a fixed location regardless of where you cloned this
# repo. Skills read the values below; if one is empty or missing they ask you.
#
# Format: shell-style KEY="value". Use absolute paths (you may use $HOME).

# install.sh: which Claude config home(s) to link skills into. Bash array.
# Defaults to ("$HOME/.claude") when unset. Uncomment to add more — e.g. a second
# personal home: CLAUDE_HOMES=("$HOME/.claude" "$HOME/.claude-personal")
# CLAUDE_HOMES=("$HOME/.claude")

# install.sh: shared skills directory that opencode and pi both auto-discover.
# Defaults to "$HOME/.agents/skills"; rarely needs changing.
# AGENTS_SKILLS_DIR="$HOME/.agents/skills"

# install.sh: where the generated opencode /<name> commands are written.
# Defaults to "$HOME/.config/opencode/command".
# OPENCODE_COMMANDS_DIR="$HOME/.config/opencode/command"

# Your name — used to attribute and shape the voice of posts/logs.
AUTHOR_NAME=""

# write-log: absolute path to your engineering log Jekyll `_posts` directory.
ENG_LOG_DIR=""

# write-post: absolute path to your personal Jekyll blog repo root.
BLOG_DIR=""

# write-post: your blog's public name/URL (e.g. "example.com"), used in copy.
BLOG_NAME=""
